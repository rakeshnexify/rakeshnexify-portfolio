NODE_ENV=production
PORT=5000

CLIENT_URL=https://your-domain.com

MONGODB_URI=your_mongodb_atlas_connection_string
MONGODB_DB_NAME=rakeshnexify_portfolio

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h

ADMIN_SETUP_PASSWORD=replace_with_a_strong_one_time_setup_password

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_MEDIA_FOLDER=rakeshnexify/media

MEDIA_IMAGE_MAX_MB=10
MEDIA_SVG_MAX_MB=5
MEDIA_DOCUMENT_MAX_MB=20
MEDIA_AUDIO_MAX_MB=50
MEDIA_VIDEO_MAX_MB=100

# Trusted reverse-proxy hops before Express. Local/direct = 0.
TRUST_PROXY_HOPS=0
